# Banco de dados (SQLite por padrão; troque para Postgres em produção)
DATABASE_URL="file:./dev.db"

# Redis (necessário para as filas BullMQ de música e render)
REDIS_URL="redis://127.0.0.1:6379"

# Onde os arquivos enviados/gerados (imagens, vídeos, áudios) são salvos
STORAGE_DIR="./storage"

# URL pública em que o app Next.js roda — o worker de render monta URLs de
# mídia (http://.../api/media/file/ID) a partir dela para o Chromium buscar
APP_BASE_URL="http://localhost:3000"

# Provedor de geração de música: "mock" (padrão, gera um tom placeholder
# sem custo/API — bom para testar o pipeline) ou "suno-api" (usa um
# provedor terceiro compatível com Suno, ver README)
MUSIC_PROVIDER="mock"

# Só necessário quando MUSIC_PROVIDER=suno-api
MUSIC_API_BASE_URL="https://api.kie.ai"
MUSIC_API_KEY=""
MUSIC_API_MODEL="V4_5"
MUSIC_GENERATION_TIMEOUT_MS="900000"

# Caminho para um binário Chromium/chrome-headless-shell local, para o
# Remotion não tentar baixar um. Deixe em branco para autodetectar um
# Chromium instalado via Playwright, ou para o Remotion baixar o dele.
REMOTION_BROWSER_EXECUTABLE=""
